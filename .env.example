# Copy to .env for local use. Never commit the real .env file.
# This service needs no secrets (sessions are random server-side tokens),
# so these are only behaviour switches.

PORT=3000

# Keep true everywhere except plain-HTTP local testing with curl.
COOKIE_SECURE=true

# Only set to true when running behind a reverse proxy you control that
# appends the real client address to X-Forwarded-For.
TRUST_PROXY=false
